GEMINI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crossover
JWT_SECRET_KEY=
# development (default) -> auth cookie: samesite=lax, no secure flag (works over local http)
# production -> auth cookie: samesite=none, secure=True (required for a cross-origin frontend, e.g. Vercel + Render)
ENVIRONMENT=development
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
